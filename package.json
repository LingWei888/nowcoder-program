{
  "name": "2OI监考客户端",
  "version": "1.0.0",
  "description": "合规在线考试客户端",
  "main": "main.js",
  "author": "LingWei",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_OPTIONS= electron .",
    "dev": "cross-env NODE_OPTIONS= electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build": "electron-builder --win --mac"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "desktop-screenshot": "^0.1.1",
    "form-data": "^4.0.5"
  },
  "build": {
    "appId": "cn.exitcode.examclient",
    "productName": "2OI监考客户端",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/favicon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/favicon.ico",
      "uninstallerIcon": "build/favicon.ico",
      "installerHeaderIcon": "build/favicon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true
    }
  }
}
